{
  "name": "resume-studio",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "check": "tsc --noEmit",
    "test": "tsx --tsconfig tsconfig.test.json --test tests/*.test.ts",
    "preview:tpl": "tsx --tsconfig tsconfig.test.json scripts/template-preview.tsx",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "desktop:runtime": "node scripts/prepare-desktop-runtime.mjs",
    "desktop:dev": "RESUME_DEV_URL=http://localhost:5173 tauri dev",
    "desktop:build": "npm run desktop:runtime && tauri build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
