{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resume Studio",
  "version": "2.3.9",
  "identifier": "dev.linzhiyuan.resume-studio",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../runtime": "runtime"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
